@online{gurkaynak_consequences_2023,
	title = {Consequences of weak monetary policy: Learning from the Turkish experience},
	url = {https://cepr.org/voxeu/columns/consequences-weak-monetary-policy-learning-turkish-experience},
	shorttitle = {Consequences of weak monetary policy},
	abstract = {Prior to 2023, the central bank of Turkey kept interest rates persistently low for over a decade. This column studies the implications of this regime, which was largely politically motivated. The Turkish lira strongly depreciated against the dollar, inflation increased to 15 times the official target, and long-term borrowing costs increased as policy rates were cut. This was accompanied by complicated regulations and policies aimed at counteracting standard market forces. The normalisation of financial system will take time, and the experience of Turkey should be a lesson for other countries considering this approach.},
