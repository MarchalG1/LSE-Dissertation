@article{chen_historical_2026,
	title = {Historical redlining and contemporary home mortgage lending: Investigating neighborhood-level racial disparities in mortgage originations in the United States},
	volume = {170},
	issn = {0264-2751},
	url = {https://www.sciencedirect.com/science/article/pii/S0264275125009357},
	doi = {10.1016/j.cities.2025.106632},
	shorttitle = {Historical redlining and contemporary home mortgage lending},
	abstract = {The persistent homeownership gap between minority and non-Hispanic White households in the United States is driven in part by enduring systemic mortgage lending inequalities. Historical discriminatory policies like redlining perpetuated racial disparities in housing by limiting credit access, fostering neighborhood disinvestment, and diminishing opportunities for wealth accumulation in minority neighborhoods. Despite this, the relationship between the legacy of historical redlining and racial disparities in contemporary mortgage lending remains underexplored. Given this, this study introduces a novel set of neighborhood-level mortgage lending measures, derived from the newly released Home Mortgage Disclosure Act Longitudinal Dataset, which adjust mortgage origination trends for neighborhood racial composition to enable analysis of the relative advantages and disadvantages experienced by different racial groups in securing mortgage loans. Using these measures, this study investigates neighborhood racial disparities in mortgage lending over the past three decades (1991–2020) across neighborhoods graded by the Home Owners’ Loan Corporation. Findings reveal that the gap in mortgage originations between African American and non-Hispanic White households is larger in historically redlined neighborhoods and has widened over time. The results also demonstrate that the interaction between historical redlining and present-day neighborhood racial composition contributes to the mortgage lending disparities faced by African American households. This study highlights the lasting impact of redlining on the racial distribution of mortgage credit and underscores the need for targeted interventions to promote equitable access to financial resources for marginalized communities.},
	pages = {106632},
	journaltitle = {Cities},
	shortjournal = {Cities},
	author = {Chen, Liang and Mitchell, Bruce C. and Laurent, Sarah E. and Edlebi, Jad K. and Meier, Helen C. S.},
	urldate = {2026-02-03},
	date = {2026-03-01},
	keywords = {Home Mortgage Disclosure Act, Home Owners’ Loan Corporation, Home mortgage, Racial disparities, Redlining, Structural racism},
}

@article{tiberto_how_2025,
	title = {How does central bank independence influence the relationship between inflation, income inequality and poverty?},
	volume = {159},
	issn = {0261-5606},
	url = {https://www.sciencedirect.com/science/article/pii/S0261560625001585},
	doi = {10.1016/j.jimonfin.2025.103423},
	abstract = {This study employs panel data analysis for 46 countries from 1980 to 2022 to investigate the impact of inflation on income inequality and poverty, highlighting the mitigating role of central bank independence. Using a comprehensive index of de jure central bank independence, the study assesses its influence on five measures of income inequality, four measures of poverty, and income deciles. The findings suggest structural factors are the main drivers of income inequality and poverty, rather than central bank independence. However, while inflation worsens these issues, central bank independence can counteract the adverse effects of inflation. Moreover, the evidence indicates greater central bank independence disproportionately benefits low-income households at the expense of high-income households, with these redistributive effects being more pronounced at higher levels of independence. In conclusion, central bank independence is pivotal in alleviating the negative impacts of inflationary shocks on income inequality and poverty, thereby promoting social and economic justice.},
	pages = {103423},
	journaltitle = {Journal of International Money and Finance},
	shortjournal = {Journal of International Money and Finance},
	author = {Tiberto, Bruno Pires},
	urldate = {2026-02-04},
	date = {2025-12-01},
	keywords = {Central bank independence, Income inequality, Inflation, Monetary policy, Poverty},
}

@article{ash_ideas_2026,
	title = {Ideas Have Consequences: The Impact of Law and Economics on American Justice*},
	volume = {141},
	issn = {0033-5533},
	url = {https://doi.org/10.1093/qje/qjaf042},
	doi = {10.1093/qje/qjaf042},
	shorttitle = {Ideas Have Consequences},
	abstract = {This article empirically studies the effects of the early law and economics movement on the U.S. judiciary. We focus on the Manne Economics Institute for Federal Judges, an intensive economics course that trained almost half of federal judges between 1976 and 1999. Using the universe of published opinions in U.S. Circuit Courts and 1 million District Court criminal sentencing decisions, we estimate the within-judge effect of Manne program attendance. Selection into attendance was limited, as the program was popular among judges of all backgrounds, frequently oversubscribed, and admitted participants on a first-come, first-served basis. We find that after attending economics training, participating judges use more economics language in their opinions, rule against regulatory agencies more often, and impose more severe criminal sentences. We argue that economics, as a rigorous social science, was especially effective in persuading judges.},
	pages = {845--887},
	number = {1},
	journaltitle = {The Quarterly Journal of Economics},
	shortjournal = {Q J Econ},
	author = {Ash, Elliott and Chen, Daniel L and Naidu, Suresh},
	urldate = {2026-02-09},
	date = {2026-02-01},
}

@article{greenwood_growth_2013,
	title = {The Growth of Finance},
	volume = {27},
	issn = {0895-3309},
	url = {https://www.aeaweb.org/articles?id=10.1257/jep.27.2.3},
	doi = {10.1257/jep.27.2.3},
	abstract = {The {US} financial services industry grew from 4.9 percent of {GDP} in 1980 to 7.9 percent of {GDP} in 2007. A sizeable portion of the growth can be explained by rising asset management fees, which in turn were driven by increases in the valuation of tradable assets, particularly equity. Another important factor was growth in fees associated with an expansion in household credit, particularly fees associated with residential mortgages. This expansion was fueled by the development of nonbank credit intermediation (or "shadow banking"). We offer a preliminary assessment of whether the growth of active asset management, household credit, and shadow banking -- the main areas of growth in the financial sector -- has been socially beneficial.},
	pages = {3--28},
	number = {2},
	journaltitle = {Journal of Economic Perspectives},
	author = {Greenwood, Robin and Scharfstein, David},
