@article{cukierman_central_2002,
	title = {Central bank reform, liberalization and inflation in transition economies—an international perspective},
	volume = {49},
	issn = {0304-3932},
	url = {https://www.sciencedirect.com/science/article/pii/S0304393201001076},
	doi = {10.1016/S0304-3932(01)00107-6},
	abstract = {This paper develops extensive new indices of legal independence (central bank independence ({CBI})) for new central banks ({CBs}) in 26 former socialist economies. The indices reveal that {CB} reform in the {FSE} during the 1990s has been quite ambitious. In spite of large price shocks, reformers in those countries chose to create {CBs} with levels of legal independence that are substantially higher, on average, than those of developed economies during the 1980s. The evidence in the paper shows that {CBI} is unrelated to inflation during the early stages of liberalization. But for sufficiently high and sustained levels of liberalization, and controlling for other variables, legal {CBI} and inflation are significantly and negatively related. These findings are consistent with the view that even high {CBI} cannot contain the initial powerful inflationary impact of price decontrols. But once the process of liberalization has gathered sufficient momentum legal independence becomes effective in reducing inflation. The paper also presents evidence on factors that affect the choice of {CBI} and examines the relation between inflation and {CBI} in a broader sample.},
	pages = {237--264},
	number = {2},
	journaltitle = {Journal of Monetary Economics},
	shortjournal = {Journal of Monetary Economics},
	author = {Cukierman, Alex and Miller, Geoffrey P. and Neyapti, Bilin},
	urldate = {2026-06-29},
	date = {2002-03-01},
	keywords = {Central banks, Inflation, Legal independence, Reform, Transition economies},
}

